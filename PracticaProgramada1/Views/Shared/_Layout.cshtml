<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Inventario</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-agro shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-semibold" href="@Url.Action("Index", "Productos")"><i class="bi bi-shop"></i> Inventario</a>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Productos")"><i class="bi bi-box-seam"></i> Productos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Create", "Productos")"><i class="bi bi-plus-circle"></i> Nuevo producto</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @Html.Partial("_Alerts")
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container">SC-601 Programación Avanzada | Práctica programada #1</div>
    </footer>
    <script>
        // Evita el doble envío: al enviar un formulario POST se desactiva su botón.
        document.addEventListener("submit", function (e) {
            var form = e.target;
            if (form.method.toLowerCase() !== "post") return;
            var botones = form.querySelectorAll("button[type=submit]");
            for (var i = 0; i < botones.length; i++) {
                botones[i].disabled = true;
            }
        });
    </script>
</body>
</html>
