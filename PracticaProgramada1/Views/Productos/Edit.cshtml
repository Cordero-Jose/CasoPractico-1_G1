@model PracticaProgramada1.ViewModels.ProductoFormViewModel
@{
    ViewBag.Title = "Editar producto";
}

<div class="form-card p-4">
    <h1 class="h3 titulo-seccion"><i class="bi bi-pencil-square"></i>Editar producto</h1>
    @using (Html.BeginForm("Edit", "Productos", new { id = Model.Producto.Id }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Producto.Id)
        @Html.Partial("_Form", Model)
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar cambios</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Index")"><i class="bi bi-arrow-left"></i> Volver</a>
        </div>
    }
</div>
