@model PracticaProgramada1.Models.Producto
@{
    ViewBag.Title = "Detalle producto";
}

<div class="form-card p-4">
    <h1 class="h3 titulo-seccion"><i class="bi bi-eye"></i>@Model.Nombre</h1>
    <dl class="row mb-0 detalle">
        <dt class="col-sm-3">Código</dt>
        <dd class="col-sm-9">@Model.Codigo</dd>
        <dt class="col-sm-3">Categoría</dt>
        <dd class="col-sm-9">@Model.Categoria.NombreCategoria</dd>
        <dt class="col-sm-3">Unidad de medida</dt>
        <dd class="col-sm-9"><span class="badge badge-unidad">@Model.UnidadMedida</span></dd>
        <dt class="col-sm-3">Precio</dt>
        <dd class="col-sm-9">@Model.Precio.ToString("N2") por @Model.UnidadMedida.ToString().ToLower()</dd>
        <dt class="col-sm-3">Existencia</dt>
        <dd class="col-sm-9">@Model.Existencia.ToString("0.###")</dd>
        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9"><span class="badge @(Model.Activo ? "badge-activo" : "badge-inactivo")">@(Model.Activo ? "Activo" : "Inactivo")</span></dd>
    </dl>
    <div class="mt-3 d-flex gap-2">
        <a class="btn btn-primary" href="@Url.Action("Edit", new { id = Model.Id })"><i class="bi bi-pencil-square"></i> Editar</a>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index")"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>
</div>
