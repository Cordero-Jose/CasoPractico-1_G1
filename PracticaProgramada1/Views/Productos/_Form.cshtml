@model PracticaProgramada1.ViewModels.ProductoFormViewModel

@Html.ValidationSummary(true, "", new { @class = "validation-summary-errors mb-3" })
<div class="row g-3">
    <div class="col-md-4">
        @Html.LabelFor(m => m.Producto.Codigo, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Producto.Codigo, new { @class = "form-control", maxlength = 12 })
        @Html.ValidationMessageFor(m => m.Producto.Codigo)
    </div>
    <div class="col-md-8">
        @Html.LabelFor(m => m.Producto.Nombre, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Producto.Nombre, new { @class = "form-control", maxlength = 80 })
        @Html.ValidationMessageFor(m => m.Producto.Nombre)
    </div>
    <div class="col-md-6">
        @Html.LabelFor(m => m.Producto.IdCategoria, new { @class = "form-label" })
        @Html.DropDownListFor(m => m.Producto.IdCategoria, Model.Categorias, "Seleccione una categoría", new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.Producto.IdCategoria)
    </div>
    <div class="col-md-6">
        @Html.LabelFor(m => m.Producto.UnidadMedida, new { @class = "form-label" })
        @Html.EnumDropDownListFor(m => m.Producto.UnidadMedida, new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.Producto.UnidadMedida)
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.Producto.Precio, "Precio (por unidad seleccionada)", new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Producto.Precio, "{0:0.00}", new { @class = "form-control", type = "number", step = "0.01" })
        @Html.ValidationMessageFor(m => m.Producto.Precio)
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.Producto.Existencia, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Producto.Existencia, "{0:0.###}", new { @class = "form-control", type = "number", step = "0.001" })
        @Html.ValidationMessageFor(m => m.Producto.Existencia)
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check form-switch mb-2">
            @Html.CheckBoxFor(m => m.Producto.Activo, new { @class = "form-check-input" })
            @Html.LabelFor(m => m.Producto.Activo, "Activo", new { @class = "form-check-label" })
        </div>
    </div>
</div>
