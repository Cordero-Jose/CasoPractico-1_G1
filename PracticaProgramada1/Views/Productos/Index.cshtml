@model PracticaProgramada1.ViewModels.ProductoIndexViewModel
@{
    ViewBag.Title = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0 titulo-seccion"><i class="bi bi-box-seam"></i>Productos</h1>
    <a class="btn btn-primary" href="@Url.Action("Create")"><i class="bi bi-plus-circle"></i> Nuevo producto</a>
</div>

@* Extensión opcional: filtro por nombre, código o categoría (no altera el CRUD). *@
<div class="table-card p-3 mb-3">
    <form action="@Url.Action("Index")" method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="buscar">Buscar</label>
            <input id="buscar" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Nombre, código o categoría" autocomplete="off" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="categoriaId">Categoría</label>
            @Html.DropDownList("categoriaId", Model.Categorias, "Todas", new { @class = "form-select" })
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Filtrar</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Index")"><i class="bi bi-x-lg"></i> Limpiar</a>
        </div>
    </form>
</div>

<div class="table-card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Existencia</th>
                    <th>Unidad</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Productos)
                {
                    <tr>
                        <td>@item.Codigo</td>
                        <td>@item.Nombre</td>
                        <td>@item.Categoria.NombreCategoria</td>
                        <td class="text-end">@item.Precio.ToString("N2")</td>
                        <td class="text-end">@item.Existencia.ToString("0.###")</td>
                        <td><span class="badge badge-unidad">@item.UnidadMedida</span></td>
                        <td>
                            <span class="badge @(item.Activo ? "badge-activo" : "badge-inactivo")">@(item.Activo ? "Activo" : "Inactivo")</span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", new { id = item.Id })" title="Ver"><i class="bi bi-eye"></i></a>
                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", new { id = item.Id })" title="Editar"><i class="bi bi-pencil-square"></i></a>
                            <a class="btn btn-sm btn-dark-agro" href="@Url.Action("Delete", new { id = item.Id })" title="Eliminar"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Productos.Any())
    {
        <p class="text-muted text-center mt-3 mb-0">No se encontraron productos.</p>
    }
</div>
<small class="text-muted d-block mt-2">Mostrando @Model.Productos.Count producto(s)</small>
